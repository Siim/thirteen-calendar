{
  "name": "@thirteen/core",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Pure TypeScript engine for 13 x 28 perennial calendars (International Fixed Calendar, Positivist). Zero runtime dependencies.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ics": "./src/ics/index.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:timing": "vitest run --config vitest.timing.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.json",
    "fixtures": "node scripts/generate-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ical.js": "2.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
