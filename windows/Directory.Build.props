<Project>
  <!-- Shared by every project in windows/Thirteen.sln. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Release numbers (docs/RELEASING.md): Version is the product version shared by every platform
         (MAJOR.MINOR.PATCH); BuildNumber only ever goes up and becomes the fourth part of the file
         version (Thirteen.exe and the installer's version info). build-windows.sh reads both. -->
    <Version>1.0.0</Version>
    <BuildNumber>1</BuildNumber>
    <FileVersion>$(Version).$(BuildNumber)</FileVersion>
    <Product>Thirteen</Product>
    <Company>Haugas Development OU</Company>
    <Authors>Haugas Development OU</Authors>
    <Copyright>Copyright (c) Haugas Development OU</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
</Project>
