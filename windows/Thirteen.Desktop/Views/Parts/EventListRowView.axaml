<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Thirteen.Desktop.ViewModels"
             x:Class="Thirteen.Desktop.Views.Parts.EventListRowView"
             x:DataType="vm:EventListRow">
  <!-- A row of Today's Up next and of the day details' Events (docs/EVENTS.md §2.8, §2.9, board B1): the time column
       (Geist Mono: "11:00" or "11:00 AM", "All day", "Day 2 of 3"), the calendar dot, the title with the "Now" plate of an
       event in progress and its "Tentative" or "Canceled" tag, and the location or "until 11:30" under it. A click or
       Enter opens the event's details (task W7). -->
  <UserControl.Styles>
    <Style Selector="Border.nowPlate">
      <Setter Property="Background" Value="{DynamicResource ThAccent}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.nowPlate TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.6" />
      <Setter Property="Foreground" Value="{DynamicResource ThOnAccent}" />
    </Style>
  </UserControl.Styles>
  <Button Name="Row" Classes="eventRow" Command="{Binding Row.OpenCommand}" CommandParameter="{Binding $self}"
          AutomationProperties.Name="{Binding Row.AutomationName}" AutomationProperties.ItemStatus="{Binding ItemStatus}">
    <Grid Name="Columns" ColumnDefinitions="72,Auto,*" ColumnSpacing="10">
      <TextBlock Classes="rowTime" TextWrapping="Wrap" Text="{Binding Row.TimeText}" Margin="0,1,0,0" />
      <Ellipse Grid.Column="1" Classes="calendarDot" Fill="{Binding Row.ColorBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
      <StackPanel Grid.Column="2" Spacing="2">
        <WrapPanel Orientation="Horizontal">
          <TextBlock Classes="rowTitle" Classes.canceled="{Binding Row.IsCanceled}" Text="{Binding Row.Title}" Margin="0,0,8,0" />
          <Border Classes="nowPlate" Margin="0,0,8,0" IsVisible="{Binding IsNow}">
            <TextBlock Text="{Binding NowText}" />
          </Border>
          <Border Classes="eventTag" IsVisible="{Binding Row.HasTag}">
            <TextBlock Text="{Binding Row.Tag}" />
          </Border>
        </WrapPanel>
        <TextBlock Classes="rowSub" Text="{Binding Row.SubText}" IsVisible="{Binding Row.HasSubText}" />
      </StackPanel>
    </Grid>
  </Button>
</UserControl>
