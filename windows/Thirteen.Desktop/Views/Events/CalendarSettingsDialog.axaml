<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Thirteen.Desktop.ViewModels"
        x:Class="Thirteen.Desktop.Views.Events.CalendarSettingsDialog"
        x:DataType="vm:CalendarSettingsViewModel"
        Classes="eventDialog"
        AutomationProperties.Name="{Binding Title}"
        Width="460">
  <!-- A calendar's settings (§2.15, the row's info button): name and color; for a subscription its link, the update
       interval, "Update now" and "Unsubscribe"; for a local calendar "Export" and "Delete calendar". Color and interval
       apply at once, the name on Close. -->
  <StackPanel Margin="24,20,24,20" Spacing="14">
    <TextBlock Classes="dialogTitle" Text="{Binding Title}" />
    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto">
      <TextBlock Classes="fieldLabel" VerticalAlignment="Center" Text="{Binding NameLabel}" />
      <TextBox Grid.Column="1" Name="NameBox" Text="{Binding Name, Mode=TwoWay}" AutomationProperties.Name="{Binding NameLabel}" />
      <TextBlock Grid.Row="1" Classes="fieldLabel" Margin="0,14,0,0" VerticalAlignment="Top" Text="{Binding ColorLabel}" />
      <ListBox Grid.Row="1" Grid.Column="1" Classes="colors" Margin="0,10,0,0" ItemsSource="{Binding Colors}"
               SelectedItem="{Binding SelectedColor, Mode=TwoWay}" AutomationProperties.Name="{Binding ColorLabel}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ColorOption">
            <Border Classes="ring" BorderThickness="2" CornerRadius="12" Padding="2" ToolTip.Tip="{Binding Name}"
                    AutomationProperties.Name="{Binding Name}">
              <Ellipse Width="18" Height="18" Fill="{Binding Brush}" />
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="2" Classes="fieldLabel" Margin="0,10,0,0" VerticalAlignment="Center" Text="{Binding LinkLabel}"
                 IsVisible="{Binding IsSubscription}" />
      <SelectableTextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap" Text="{Binding Link}"
                           IsVisible="{Binding IsSubscription}" AutomationProperties.Name="{Binding LinkLabel}" />
      <TextBlock Grid.Row="3" Classes="fieldLabel" Margin="0,10,0,0" VerticalAlignment="Center" Text="{Binding UpdateLabel}"
                 IsVisible="{Binding IsSubscription}" />
      <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" MinWidth="180" ItemsSource="{Binding Intervals}"
                SelectedItem="{Binding SelectedInterval, Mode=TwoWay}" IsVisible="{Binding IsSubscription}"
                AutomationProperties.Name="{Binding UpdateLabel}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:IntervalOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding UpdateNowText}" Command="{Binding UpdateNowCommand}" IsVisible="{Binding IsSubscription}"
                AutomationProperties.Name="{Binding UpdateNowText}" />
        <Button Content="{Binding UnsubscribeText}" Command="{Binding UnsubscribeCommand}" IsVisible="{Binding IsSubscription}"
                AutomationProperties.Name="{Binding UnsubscribeText}" />
        <Button Content="{Binding ExportText}" Command="{Binding ExportCommand}" IsVisible="{Binding IsLocal}"
                AutomationProperties.Name="{Binding ExportText}" />
        <Button Content="{Binding DeleteText}" Command="{Binding DeleteCommand}" IsVisible="{Binding IsLocal}"
                AutomationProperties.Name="{Binding DeleteText}" />
      </StackPanel>
      <Button Grid.Column="1" Classes="accent" MinWidth="96" HorizontalContentAlignment="Center" Content="{Binding CloseText}"
              Command="{Binding CloseCommand}" IsDefault="True" AutomationProperties.Name="{Binding CloseText}" />
    </Grid>
  </StackPanel>
</Window>
