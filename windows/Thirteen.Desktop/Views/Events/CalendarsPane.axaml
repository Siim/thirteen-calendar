<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Thirteen.Desktop.ViewModels"
             xmlns:c="using:Thirteen.Desktop.Controls"
             x:Class="Thirteen.Desktop.Views.Events.CalendarsPane"
             x:DataType="vm:CalendarsPaneViewModel"
             AutomationProperties.Name="{Binding Title}">
  <!-- The Calendars pane (docs/EVENTS.md §2.15, §2.16; boards D2, L1, L2): the offline banner, "On this computer" and
       "Subscriptions" (each collapsible, with "Hide all" / "Show all"), a row per calendar (visibility checkbox, color
       swatch, name, "Read only" tag, status line with "Try again" or "Open folder", the settings button), the four
       actions and the storage line. The Calendar section (task W5) places it in its sidebar. -->
  <Border Classes="calendarsPane">
    <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="10,12,10,14" Spacing="4">

        <!-- Offline (§2.16): one banner; the rows show no network errors meanwhile. -->
        <Border Name="OfflineBanner" Classes="banner" Margin="0,0,0,8" IsVisible="{Binding IsOffline}">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Classes="icon" FontSize="14" Margin="0,1,8,0" VerticalAlignment="Top" Text="&#xE946;" />
            <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" Text="{Binding OfflineText}" />
          </Grid>
        </Border>

        <ItemsControl Name="GroupList" ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CalendarGroupViewModel">
              <StackPanel IsVisible="{Binding IsShown}" Margin="0,0,0,10">
                <!-- The title, then "Hide all" beside it, or under it when large text leaves no room (§2.20 "Text size"). -->
                <c:ToolbarLayout Spacing="0" LeadingMinWidth="150">
                  <!-- The chevron collapses the group; collapsed, it reads "{n} calendars, {m} shown". -->
                  <Button Classes="subtle groupHeader" Command="{Binding ToggleCollapsedCommand}"
                          AutomationProperties.Name="{Binding HeaderName}">
                    <Grid ColumnDefinitions="Auto,*">
                      <Panel Width="16" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Classes="icon" FontSize="10" Text="&#xE70D;" IsVisible="{Binding IsExpanded}" />
                        <TextBlock Classes="icon" FontSize="10" Text="&#xE76C;" IsVisible="{Binding IsCollapsed}" />
                      </Panel>
                      <StackPanel Grid.Column="1" Spacing="1">
                        <!-- Wraps at large text sizes rather than being cut by "Hide all" (§2.20 "Text size"). -->
                        <TextBlock Classes="groupTitle" Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Classes="status" Text="{Binding CollapsedText}" IsVisible="{Binding IsCollapsed}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <Button Classes="link" Margin="8,0,6,0" MinHeight="32" MinWidth="32" VerticalContentAlignment="Center" VerticalAlignment="Center" FontSize="12"
                          Content="{Binding ToggleAllText}" Command="{Binding ToggleAllCommand}" IsVisible="{Binding !IsEmpty}"
                          AutomationProperties.Name="{Binding ToggleAllText}" />
                </c:ToolbarLayout>

                <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding IsExpanded}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CalendarRowViewModel">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="6,3,0,3">
                        <CheckBox Name="VisibleBox" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Top"
                                  MinWidth="0" Padding="0" Margin="0,-4,4,0"
                                  AutomationProperties.Name="{Binding AccessibleName}" ToolTip.Tip="{Binding Name}" />
                        <!-- The swatch changes the calendar's color (Windows and web, §2.15). -->
                        <Button Grid.Column="1" Classes="swatch" Margin="0,-4,4,-6" VerticalAlignment="Top"
                                AutomationProperties.Name="{Binding ColorName}" ToolTip.Tip="{Binding ColorName}">
                          <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                              <ListBox Classes="colors" Width="180" ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                                       AutomationProperties.Name="{Binding ColorName}">
                                <ListBox.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                  </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ColorOption">
                                    <Border Classes="ring" BorderThickness="2" CornerRadius="12" Padding="2"
                                            ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                                      <Ellipse Width="18" Height="18" Fill="{Binding Brush}" />
                                    </Border>
                                  </DataTemplate>
                                </ListBox.ItemTemplate>
                              </ListBox>
                            </Flyout>
                          </Button.Flyout>
                          <Ellipse Name="SwatchDot" Width="20" Height="20" Fill="{Binding Swatch}" />
                        </Button>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                          <Grid ColumnDefinitions="*,Auto">
                            <!-- The name wraps (up to two lines) beside the "Read only" tag of a subscription, as on the web. -->
                            <TextBlock Name="NameText" FontSize="13.5" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Text="{Binding Name}" />
                            <Border Grid.Column="1" Name="ReadOnlyTag" Classes="tag" Margin="6,0,0,0" VerticalAlignment="Top" IsVisible="{Binding IsReadOnly}">
                              <TextBlock FontSize="11" Text="{Binding ReadOnlyText}" />
                            </Border>
                          </Grid>
                          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasStatus}">
                            <TextBlock Classes="icon statusIcon" Text="&#xE7BA;" IsVisible="{Binding IsWarning}" />
                            <TextBlock Classes="icon statusIcon" Text="&#xEA39;" IsVisible="{Binding IsError}" />
                            <TextBlock Classes="icon statusIcon spinner" Foreground="{DynamicResource ThInk3}" Text="&#xE895;"
                                       IsVisible="{Binding IsUpdating}" />
                            <TextBlock Grid.Column="1" Classes="status" Classes.error="{Binding IsError}" Text="{Binding StatusText}" />
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="14">
                            <Button Classes="link" FontSize="12" Content="{Binding TryAgainText}" Command="{Binding TryAgainCommand}"
                                    IsVisible="{Binding CanTryAgain}" AutomationProperties.Name="{Binding TryAgainText}" />
                            <Button Classes="link" FontSize="12" Content="{Binding OpenFolderText}" Command="{Binding OpenFolderCommand}"
                                    IsVisible="{Binding CanOpenFolder}" AutomationProperties.Name="{Binding OpenFolderText}" />
                          </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="3" Classes="subtle" Width="32" Height="32" Padding="0" Margin="4,-5,0,-4" VerticalAlignment="Top"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Command="{Binding SettingsCommand}" ToolTip.Tip="{Binding SettingsTip}"
                                AutomationProperties.Name="{Binding SettingsName}">
                          <TextBlock Classes="icon" FontSize="14" Text="&#xE946;" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Windows footer (§2.15): the four actions (their labels wrap at large text sizes), then the storage line (§2.16). -->
        <StackPanel Spacing="2" Margin="0,4,0,0">
          <Button Classes="subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                  Command="{Binding NewCalendarCommand}" AutomationProperties.Name="{Binding NewCalendarText}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Classes="icon" FontSize="14" VerticalAlignment="Center" Text="&#xE710;" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding NewCalendarText}" />
            </Grid>
          </Button>
          <Button Classes="subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                  Command="{Binding SubscribeCommand}" AutomationProperties.Name="{Binding SubscribeText}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Classes="icon" FontSize="14" VerticalAlignment="Center" Text="&#xE71B;" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding SubscribeText}" />
            </Grid>
          </Button>
          <Button Classes="subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                  Command="{Binding ImportCommand}" AutomationProperties.Name="{Binding ImportText}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Classes="icon" FontSize="14" VerticalAlignment="Center" Text="&#xE8B5;" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ImportText}" />
            </Grid>
          </Button>
          <Button Classes="subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,6"
                  Command="{Binding ExportCommand}" AutomationProperties.Name="{Binding ExportText}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Classes="icon" FontSize="14" VerticalAlignment="Center" Text="&#xEDE1;" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ExportText}" />
            </Grid>
          </Button>
        </StackPanel>
        <WrapPanel Margin="8,10,8,0">
          <TextBlock Classes="status" Margin="0,0,6,0" VerticalAlignment="Center" Text="{Binding StorageText}" />
          <Button Classes="link" FontSize="12" Content="{Binding OpenFolderText}" Command="{Binding OpenFolderCommand}"
                  IsVisible="{Binding HasFolder}" AutomationProperties.Name="{Binding OpenFolderText}" />
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
