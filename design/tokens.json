      "exceptions": [
        {
          "rule": "no-pure-black-white",
          "platform": "web",
          "mode": "dark",
          "role": "scrim",
          "reason": "tokens.css ships rgb(0 0 0 / 0.55); Almanac reproduces the shipped web app."
        },
        {
          "rule": "no-pure-black-white",
          "platform": "web",
          "mode": "dark",
          "role": "shadow",
          "reason": "tokens.css ships dark shadows in rgb(0 0 0); Almanac reproduces the shipped web app."
        },
        {
          "rule": "no-pure-black-white",
          "platform": "apple",
          "mode": "light",
          "role": "on-foil",
          "reason": "OnFoil.colorset is #ffffff in the shipped Apple apps; Almanac reproduces them."
        }
      ]
