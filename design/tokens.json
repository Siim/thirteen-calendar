{
  "$comment": "Single source of truth for every colour in Thirteen (design/DECISIONS.md). Edit here, then run `pnpm tokens:check` and `pnpm tokens`. Values: \"#rrggbb\", \"#rrggbb / alpha\", or \"{role}\" to reuse another role of the same theme and mode. See design/README.md.",
  "defaultTheme": "almanac",
  "schemes": {
    "$comment": "How Settings groups the themes. A theme without \"scheme\" is adaptive (a light and a dark map, following the system or the pinned mode). \"scheme\": \"dark\" themes are always dark: they have only a \"dark\" map, every platform forces the dark colour scheme while one is selected, and they are listed after the adaptive ones.",
    "adaptive": {
      "name": "Light and dark",
      "description": "Follows the system, or the Appearance setting."
    },
    "dark": {
      "name": "Dark",
      "description": "Always dark, whatever the system or the Appearance setting."
    }
  },
  "roles": {
    "paper": "Page background.",
    "paper-raised": "Cards, popovers and raised surfaces.",
    "paper-sunk": "Wells, grid cells and inset surfaces.",
    "ink": "Primary text (12:1 or more on every paper).",
    "ink-2": "Secondary text (7:1 or more on every paper).",
    "ink-3": "Tertiary text and captions (4.5:1 or more on every paper).",
    "rule": "Hairlines and card strokes.",
    "rule-soft": "Faint dividers inside a surface.",
    "rule-strong": "Emphasised rules: the almanac's heavy lines.",
    "accent": "The theme's signal colour for fills and marks: today, progress, selection. Not for body text.",
    "accent-text": "Accent for text and icons on paper and on accent-wash (4.5:1 or more).",
    "accent-wash": "Soft opaque accent fill behind accent text.",
    "accent-soft": "Translucent accent tint for hover and selected backgrounds.",
    "on-accent": "Text and glyphs on a solid accent fill.",
    "control-tint": "Tint of system controls (Apple .tint, Android and Windows control accents). Light: 4.5:1 or more on paper. Dark: 4.5:1 or more on every paper, and white text on it 3:1 or more.",
    "foil": "The Gregorian foil: everything 12-month, in a colour clearly apart from the accent.",
    "foil-wash": "Soft opaque foil fill behind foil text.",
    "foil-soft": "Translucent foil tint.",
    "on-foil": "Text and glyphs on a solid foil fill.",
    "focus": "Keyboard focus ring (3:1 or more against paper).",
    "scrim": "Translucent overlay behind sheets and dialogs.",
    "grain": "Tint of the paper grain texture (web).",
    "shadow": "Colour of drop shadows (alpha comes from \"shadows\")."
  },
  "shadows": {
    "$comment": "Shared by every theme. The colour is the theme's \"shadow\" role at this alpha; geometry is a CSS box-shadow offset/blur/spread.",
    "shadow-1": {
      "light": { "geometry": "0 1px 0", "alpha": 0.06 },
      "dark": { "geometry": "0 1px 0", "alpha": 0.4 }
    },
    "shadow-2": {
      "light": { "geometry": "0 18px 40px -24px", "alpha": 0.35 },
      "dark": { "geometry": "0 22px 48px -24px", "alpha": 0.75 }
    }
  },
